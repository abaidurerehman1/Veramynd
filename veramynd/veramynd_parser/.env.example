# OpenAI credentials for Stage 3 ELA normalization + embeddings.
# Copy to .env and fill in your key:

# Required — get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — normalize chat model (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Optional — embedding model (default: text-embedding-3-large)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Qdrant — set ONLY ONE backend to avoid silent dual-mode mistakes.
# Prefer Docker URL for shared enterprise runs:
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Local embedded store is used ONLY when QDRANT_URL is unset/empty:
# QDRANT_PATH=.qdrant_data
QDRANT_COLLECTION=veramynd_chunks
QDRANT_STANDARDS_COLLECTION=veramynd_standards
# Note: alignment retrieve queries veramynd_standards only.
# veramynd_chunks is for lesson search / future coverage features.

# Optional — local cross-encoder for retrieve-standards (default: BAAI/bge-reranker-base)
# Requires: pip install -e '.[retrieve]'
RERANK_MODEL=BAAI/bge-reranker-base

# Alignment judge — enterprise K-12 defaults (batch + escalate ON)
JUDGE_MODEL=gpt-4.1
JUDGE_ESCALATE_MODEL=gpt-5
# Pass --no-escalate on CLI for cheaper smoke runs without the cascade.
