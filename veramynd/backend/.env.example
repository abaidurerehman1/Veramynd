# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5433/veramynd

# Auth JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8000

# SMTP (email verification)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Veramynd <you@example.com>
SMTP_USE_TLS=true

# Google OAuth (optional — leave empty to hide Google button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback
