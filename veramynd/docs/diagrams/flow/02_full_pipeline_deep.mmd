%% Veramynd — Full Product Flow (Deep) — Current locked pipeline
%% Source for docs/diagrams/flow/02_full_pipeline_deep.png
%% No lesson chunking: queries from normalize; judge grounds on Stage-1 raw text.
flowchart TB
  subgraph INPUTS["INPUTS"]
    PDF["Teacher Guide PDF"]
    XLSX["Standards XLSX<br/>Code | Standard Text | Notes"]
  end

  subgraph S1["STAGE 1 — PARSE + VERIFY"]
    SEP["Separate lessons<br/>bookmarks → font-header fallback"]
    DIV["Divide lesson<br/>agenda · steps · materials · vocab"]
    STD["Parse standards tree<br/>dotted grade-prefixed codes"]
    ENG["Docling primary · PyMuPDF fallback"]
  end

  VER{"Verifier:<br/>any hard FAIL?"}
  BLOCK["YES → BLOCK<br/>withhold trusted lessons"]

  subgraph NORM["NORMALIZE"]
    LN["normalize-lessons<br/>ELA schema · OpenAI cache"]
    SN["normalize-standards<br/>standard + substandard leaves"]
    LANES["Normalize → retrieve queries<br/>Stage-1 raw → judge grounding"]
  end

  subgraph EMB["EMBED + INDEX"]
    E1["text-embedding-3-large 3072-d"]
    QS["Qdrant veramynd_standards<br/>leaf-only · rich retrieval text"]
  end

  subgraph RET["RETRIEVE — Lesson → Standards"]
    Q["Queries from NormalizedLesson<br/>multi_normalize_focused"]
    D["Dense → veramynd_standards"]
    B["BM25 → standard embed text"]
    RRF["RRF merge + CE rerank"]
    SL["Judge shortlist top ~25–50"]
  end

  subgraph JUD["JUDGE"]
    J1["assembled_judge_prompt.md v1.1"]
    J2["Anthropic batch + escalate"]
    J3["full / partial / none + quote"]
  end

  subgraph GR["GROUNDING"]
    G1["Quote must exist in Stage-1 lesson"]
    G2["Empty / ungrounded → force none"]
  end

  subgraph REP["REPORT"]
    CSV["CSV + HTML + gold metrics"]
    CLIENT["Client correlation<br/>DOCX / XLSX skill roll-ups"]
  end

  OUT["OUTPUT: trusted alignment artifacts"]

  PDF --> SEP --> DIV --> VER
  XLSX --> STD --> VER
  ENG --> DIV
  VER -->|GO| LN
  VER -->|BLOCK| BLOCK
  LN --> SN --> LANES --> E1 --> QS
  QS --> Q
  Q --> D --> RRF
  Q --> B --> RRF
  RRF --> SL --> J1 --> J2 --> J3 --> G1 --> G2 --> CSV --> CLIENT --> OUT
