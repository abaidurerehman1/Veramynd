%% Veramynd — Query Funnel Deep Dive (current locked path)
%% Source for docs/diagrams/flow/03_query_funnel_deep.png
%% Query text comes from NormalizedLesson — not lesson chunks.
flowchart TB
  START["START: NormalizedLesson queries<br/>multi_normalize_focused arms"]

  subgraph ARMS["Hybrid arms"]
    DENSE["DENSE<br/>embed query → veramynd_standards<br/>Cosine top ~50"]
    BM25["BM25<br/>word match on leaf embed text<br/>top ~50"]
  end

  RRF["RRF / top_k_sum merge<br/>recall over-include"]
  RERANK["Local CE rerank<br/>bge-reranker · shortlist ~25–50"]
  JUDGE["Judge shortlist<br/>Stage-1 raw lesson + standard raw_text<br/>assembled prompt v1.1"]
  GROUND{"Quote grounded<br/>in Stage-1 lesson?"}
  REJECT["NO → force none<br/>keep quote for audit"]
  SHIP["YES → ship verdict<br/>CSV / HTML / client DOCX"]

  START --> DENSE
  START --> BM25
  DENSE --> RRF
  BM25 --> RRF
  RRF --> RERANK --> JUDGE --> GROUND
  GROUND -->|YES| SHIP
  GROUND -->|NO| REJECT
